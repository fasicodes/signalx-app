# SignalX / Signals FM - environment variables (Railway -> Variables).
# Copy the names you need; never commit real values. Everything secret stays on the server.

# ---------------------------------------------------------------- core (required)
SECRET_KEY=                       # long random string (Flask sessions)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=signalx_db
SITE_URL=https://your-domain       # used in emails, Telegram links, canonical URLs and the sitemap
ALLOWED_ORIGIN=https://your-domain # CORS origin for the API
ADMIN_EMAILS=you@example.com       # comma-separated: these logins get the admin tools (articles, cancel a signal)

# ---------------------------------------------------------------- AI assistant (site widget + bot page)
ANTHROPIC_API_KEY=                 # turns on AI answers; without it the assistant answers from the site's built-in help
ASSISTANT_MODEL=claude-haiku-5-5   # optional
ASSISTANT_PER_HOUR=30              # AI answers per logged-in user per hour
ASSISTANT_GUEST_PER_HOUR=8         # AI answers per visitor (IP) per hour
ASSISTANT_AI_PER_HOUR=40           # bot page assistant, per user per hour

# ---------------------------------------------------------------- signals
SIGNAL_STREAMS=                    # empty (recommended) = only the streams whose model passed its test on unseen data
                                   # (models/research.json); all = all six; or a list, e.g. crypto_4h,crypto_1h
SIGNAL_HUB=on                      # off = no background scanner / tracker on this instance
SIGNAL_BOARD=on                    # crypto 4h engine refresh (signal engine v3.1)
FOREX_SIGNAL_PAIRS=                # optional override, e.g. EUR/USD,GBP/USD,USD/JPY,XAU/USD
TRACK_RECORD_ENGINE=on
TRACK_RECORD_PUBLIC=off            # on = /track-record visible to visitors
MODELS_DIR=                        # optional: folder with models/<market>_<timeframe>.json (default ./models)

# ---------------------------------------------------------------- forex prices
TWELVEDATA_API_KEY=                # recommended (free plan: 8 requests/min, 800/day - enough for 1h and 4h;
                                   # the 15m forex stream needs a paid plan, or drop forex_15m from SIGNAL_STREAMS)
TWELVEDATA_PER_MINUTE=7            # set to your plan's per-minute limit minus one

# ---------------------------------------------------------------- news + economic calendar
FMP_API_KEY=                       # Financial Modeling Prep: economic calendar (paid plan) + news
FINNHUB_API_KEY=                   # Finnhub: market news (free plan); calendar only with a paid plan
FINNHUB_CALENDAR=on                # off = use Finnhub for news only
FMP_NEWS=on
TRADING_ECONOMICS_KEY=             # alternative calendar source
NEWS_RSS_FEEDS=                    # optional: "Name|https://feed,Name2|https://feed2" (default: central-bank feeds); off = none
NEWS_JOB=on
NEWS_REFRESH_MIN=10
CALENDAR_REFRESH_MIN=30
NEWS_BLACKOUT_BEFORE_MIN=30        # no new forex signal for a currency from 30 min before ...
NEWS_BLACKOUT_AFTER_MIN=15         # ... to 15 min after its high-impact events
NEWS_BLACKOUT_CRYPTO=off           # on = also pause crypto signals around USD high-impact events
NEWS_WARNING_HOURS=12              # warn on a signal when a high-impact event is this close

# ---------------------------------------------------------------- auto-trade bot
AUTOTRADE_ENCRYPTION_KEY=          # REQUIRED to connect Binance / OANDA. Generate once:
                                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                   # never change it later (saved keys could not be decrypted)
AUTOTRADE_ENGINE=on
AUTOTRADE_MONITOR_SEC=10
FOREX_PAPER_BALANCE=10000          # virtual USD balance for forex on the Site demo account
PAPER_ENGINE=on
PAPER_ENGINE_INTERVAL=2

# ---------------------------------------------------------------- email, Telegram, login, analytics
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Signals FM
SUPPORT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GA_MEASUREMENT_ID=
FLASK_DEBUG=0    
